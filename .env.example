# Indexers (server-only)
ANKR_API_KEY=
MORALIS_API_KEY=

# Optional dedicated RPCs
SOLANA_RPC_URL=
TRONGRID_API_KEY=

# Monad Testnet RPC override (defaults to https://testnet-rpc.monad.xyz)
MONAD_RPC_URL=

# Reown AppKit / WalletConnect Cloud — https://dashboard.reown.com
# Required for the 500+ wallet catalog (QR + mobile). Injected wallets still
# work without it. NEXT_PUBLIC_PROJECT_ID is also accepted.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Local tip smoke test only — NEVER commit this value
# MONAD_TEST_PK=
